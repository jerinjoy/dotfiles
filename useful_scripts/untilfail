# Run a command repeatedly until it fails (exits non-zero).
# Usage: untilfail <command> [args...]

set -uo pipefail

if [ $# -eq 0 ]; then
  echo "usage: untilfail <command> [args...]" >&2
  exit 2
fi

n=0
while true; do
  n=$((n + 1))
  echo "[run $n]"
  "$@" || exit $?
done
