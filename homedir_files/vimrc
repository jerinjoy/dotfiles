" Minimal fallback config — neovim is the primary editor

syntax enable
filetype plugin indent on
set autoindent
set smartindent
set backspace=2
set wildmenu
set hlsearch
set incsearch
set showmatch
set laststatus=2
set cursorline
set colorcolumn=80
set mouse=a
set clipboard=unnamed

set expandtab
set tabstop=2
set softtabstop=2
set shiftwidth=2

set number
set relativenumber
set signcolumn=yes
set scrolloff=8
set undofile
set undolevels=1000
set termguicolors

nnoremap <Tab> :bnext<CR>
nnoremap <S-Tab> :bprevious<CR>
nnoremap <Esc> :noh<CR>

let &t_SI = "\e[5 q"
let &t_SR = "\e[3 q"
let &t_EI = "\e[1 q"
